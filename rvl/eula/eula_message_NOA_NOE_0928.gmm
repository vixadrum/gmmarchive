	<row id="00_0" number="0" back-color=",,,,,#00ff00,#00ff00,#00ff00,,,,,,#ff0000,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,">
		<attribute name="comment_jpn">インターネット接続に関するメッセージ</attribute>
		<attribute name="comment_english">internet connection status message</attribute>
		<language name="Japanese">インターネットに接続しています。
しばらくお待ちください。</language>
		<language name="English-tmp">Connecting to the Internet.
Please wait a moment.</language>
		<language name="English_US">Connecting to the Internet...
Please wait a moment.</language>
		<language name="English_EU">Connecting to the Internet...
Please wait a moment.</language>
		<language name="Spanish">Estableciendo la conexión
a internet...
Espera unos instantes.</language>
		<language name="German">Die Internet-Verbindung wird
aufgebaut. Bitte warten.</language>
		<language name="French">Connexion à Internet en cours.
Patientez un moment.</language>
		<language name="Italian">Collegamento a Internet in corso.
Attendi...</language>
		<language name="Nederland">Er wordt een verbinding met het
internet gemaakt. Een ogenblik geduld.</language>
	</row>

