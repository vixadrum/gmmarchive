	<row id="06_0" number="6" back-color=",,,,,#00ff00,#00ff00,#00ff00,,,,,,#ff0000,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,">
		<attribute name="comment_jpn">サービス契約の確認に関するメッセージ</attribute>
		<attribute name="comment_english">user needs to 
view the terms of use 
(user agreement)</attribute>
		<language name="Japanese">Wiiネットワークサービスに関する
利用規約を確認してください。</language>
		<language name="English-tmp">Please review the Terms of Use
for Wii Network Services.</language>
		<language name="English_US">You must review the User Agreements
before using Wii network services.</language>
		<language name="English_EU">You must review the Wii Network
Services agreement before using
Wii Network Services.</language>
		<language name="Spanish">Acepta los términos del Contrato de
Uso de los Servicios de Red de Wii.</language>
		<language name="German">Bitte akzeptiere den Vertrag zur
Nutzung des Wii-Internet-Services.</language>
		<language name="French">Veuillez lire les documents légaux
relatifs aux services en ligne Wii.</language>
		<language name="Italian">Accetta l&apos;Accordo per l&apos;utilizzo
dei servizi Internet Wii.</language>
		<language name="Nederland">Lees voor gebruik de overeenkomst
voor Wii-internetdiensten.</language>
	</row>

	<row id="07_0" number="7" back-color=",,,,,#00ff00,#00ff00,#00ff00,,,,,,#ff0000,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,">
		<attribute name="comment_jpn">サービス契約の確認に関するメッセージ</attribute>
		<attribute name="comment_english">after setting up an 
internet connection</attribute>
		<language name="Japanese">Wiiショッピングチャンネルや
WiiConnect24を使用するには
インターネットの設定をした後、
利用規約を確認してください。</language>
		<language name="English-tmp">To use the Wii Shop Channel
or WiiConnect24, after setting up
the Internet connection, please review
the Terms of Use.</language>
		<language name="English_US">To use WiiConnect24 and the
Wii Shop Channel, please confirm the
user agreement after configuring
Internet settings.</language>
		<language name="English_EU">To use WiiConnect24 and the
Wii Shop Channel, please confirm the
Wii Network Services agreement after
configuring Internet settings.</language>
		<language name="Spanish">Para poder usar los servicios del
Canal Tienda Wii y WiiConnect24,
configura tu conexión a internet y
acepta los términos del Contrato de
Uso de los Servicios de Red de Wii.</language>
		<language name="German">Bitte nimm die Internet-Einstellungen
vor und akzeptiere den Vertrag zur
Nutzung des Wii-Internet-Services,
damit du den Wii-Shop-Kanal sowie
WiiConnect24 nutzen kannst.</language>
		<language name="French">Pour utiliser la chaîne boutique Wii
et WiiConnect24, paramétrez votre
connexion Internet puis lisez
attentivement les documents légaux.</language>
		<language name="Italian">Per poter utilizzare il Canale Wii Shop
e WiiConnect24, è necessario accettare
l&apos;Accordo per l&apos;utilizzo dei servizi
Internet Wii dopo aver configurato la
connessione a Internet.</language>
		<language name="Nederland">Om het Wii-winkelkanaal en
WiiConnect24 te gebruiken, moet je een
verbinding met het internet instellen en
akkoord gaan met de overeenkomst
voor Wii-internetdiensten.</language>
	</row>

	<row id="08_0" number="8" back-color=",,,,,#00ff00,#00ff00,#00ff00,,,,,,#ff0000,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,">
		<attribute name="comment_jpn">オンラインサービスが利用できない旨のメッセージ</attribute>
		<attribute name="comment_english">services currently 
unavailable</attribute>
		<language name="Japanese">WiiConnect24および
Wiiショッピングチャンネルの
サービスは現在提供していません。</language>
		<language name="English-tmp">The WiiConnect24 and
Wii Shop Channel services
are not currently available.</language>
		<language name="English_US">WiiConnect24 and Wii Shop Channel
service is not currently being offered.</language>
		<language name="English_EU">WiiConnect24 and Wii Shop Channel
service is not currently being offered.</language>
		<language name="Spanish">WiiConnect24 y el Canal Tienda Wii no
están disponibles en este momento.</language>
		<language name="German">WiiConnect24 sowie der Wii-Shop-Kanal
stehen zurzeit nicht zur Verfügung.</language>
		<language name="French">WiiConnect24 ainsi que la chaîne
boutique Wii ne sont pas disponibles
actuellement.</language>
		<language name="Italian">WiiConnect24 e il Canale Wii Shop
non sono al momento disponibili.</language>
		<language name="Nederland">WiiConnect24 en het Wii-winkelkanaal
zijn op dit moment niet beschikbaar.</language>
	</row>

	<row id="09_0" number="9" back-color=",,,,,#00ff00,#00ff00,#00ff00,,,,,,#ff0000,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,#00ff00,,,,,,">
		<attribute name="comment_jpn">エラー: インターネット接続がありません</attribute>
		<attribute name="comment_english">connection error message.</attribute>
		<language name="Japanese">インターネットに接続できませんでした。</language>
		<language name="English-tmp">Could not connect to the Internet.</language>
		<language name="English_US">Unable to connect to the Internet.</language>
		<language name="English_EU">Unable to connect to the Internet.</language>
		<language name="Spanish">No se ha podido establecer
la conexión a internet.</language>
